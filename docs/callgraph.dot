digraph tuff {
  rankdir=TB;
  splines=ortho;
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", fontname="Consolas"];
  edge [color="#64748b"];
  subgraph "cluster_src_errors_ts" {
    style="rounded";
    color="#94a3b8";
    fontname="Consolas";
    fontsize=12;
    label="src\\errors.ts";
    "src\\errors.ts::fail" [label="fail"];
  }
  subgraph "cluster_src_evaluate_ts" {
    style="rounded";
    color="#94a3b8";
    fontname="Consolas";
    fontsize=12;
    label="src\\evaluate.ts";
    "src\\evaluate.ts::evaluate" [label="evaluate"];
  }
  subgraph "cluster_src_interpreter_ts" {
    style="rounded";
    color="#94a3b8";
    fontname="Consolas";
    fontsize=12;
    label="src\\interpreter.ts";
    "src\\interpreter.ts::valueType" [label="valueType"];
    "src\\interpreter.ts::evalExpr" [label="evalExpr"];
    "src\\interpreter.ts::execStatement" [label="execStatement"];
    "src\\interpreter.ts::execStatements" [label="execStatements"];
    "src\\interpreter.ts::interpret" [label="interpret"];
  }
  subgraph "cluster_src_lexer_ts" {
    style="rounded";
    color="#94a3b8";
    fontname="Consolas";
    fontsize=12;
    label="src\\lexer.ts";
    "src\\lexer.ts::tokenize" [label="tokenize"];
  }
  subgraph "cluster_src_parser_ts" {
    style="rounded";
    color="#94a3b8";
    fontname="Consolas";
    fontsize=12;
    label="src\\parser.ts";
    "src\\parser.ts::peek" [label="peek"];
    "src\\parser.ts::advance" [label="advance"];
    "src\\parser.ts::parseStatements" [label="parseStatements"];
    "src\\parser.ts::parseExprAndSemicolon" [label="parseExprAndSemicolon"];
    "src\\parser.ts::expectOpenBrace" [label="expectOpenBrace"];
    "src\\parser.ts::parsePlainStatement" [label="parsePlainStatement"];
    "src\\parser.ts::parseOperand" [label="parseOperand"];
    "src\\parser.ts::parseExpr" [label="parseExpr"];
    "src\\parser.ts::parseOr" [label="parseOr"];
    "src\\parser.ts::parseAnd" [label="parseAnd"];
    "src\\parser.ts::parseComparison" [label="parseComparison"];
    "src\\parser.ts::parseConditionBlock" [label="parseConditionBlock"];
    "src\\parser.ts::parseIf" [label="parseIf"];
    "src\\parser.ts::parseWhile" [label="parseWhile"];
    "src\\parser.ts::groupStatements" [label="groupStatements"];
  }
  "src\\evaluate.ts::evaluate" -> "src\\lexer.ts::tokenize";
  "src\\evaluate.ts::evaluate" -> "src\\parser.ts::groupStatements";
  "src\\evaluate.ts::evaluate" -> "src\\interpreter.ts::interpret";
  "src\\interpreter.ts::evalExpr" -> "src\\errors.ts::fail";
  "src\\interpreter.ts::evalExpr" -> "src\\interpreter.ts::evalExpr";
  "src\\interpreter.ts::execStatement" -> "src\\errors.ts::fail";
  "src\\interpreter.ts::execStatement" -> "src\\interpreter.ts::evalExpr";
  "src\\interpreter.ts::execStatement" -> "src\\interpreter.ts::valueType";
  "src\\interpreter.ts::execStatements" -> "src\\interpreter.ts::execStatements";
  "src\\interpreter.ts::execStatements" -> "src\\errors.ts::fail";
  "src\\interpreter.ts::execStatements" -> "src\\interpreter.ts::evalExpr";
  "src\\interpreter.ts::execStatements" -> "src\\interpreter.ts::execStatement";
  "src\\interpreter.ts::interpret" -> "src\\interpreter.ts::execStatements";
  "src\\lexer.ts::tokenize" -> "src\\errors.ts::fail";
  "src\\parser.ts::parseStatements" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseStatements" -> "src\\parser.ts::parseStatements";
  "src\\parser.ts::parseStatements" -> "src\\errors.ts::fail";
  "src\\parser.ts::parseStatements" -> "src\\parser.ts::parseIf";
  "src\\parser.ts::parseStatements" -> "src\\parser.ts::parseWhile";
  "src\\parser.ts::parseStatements" -> "src\\parser.ts::parsePlainStatement";
  "src\\parser.ts::parseExprAndSemicolon" -> "src\\parser.ts::parseExpr";
  "src\\parser.ts::parseExprAndSemicolon" -> "src\\parser.ts::peek";
  "src\\parser.ts::parseExprAndSemicolon" -> "src\\errors.ts::fail";
  "src\\parser.ts::parseExprAndSemicolon" -> "src\\parser.ts::advance";
  "src\\parser.ts::expectOpenBrace" -> "src\\parser.ts::peek";
  "src\\parser.ts::expectOpenBrace" -> "src\\errors.ts::fail";
  "src\\parser.ts::expectOpenBrace" -> "src\\parser.ts::advance";
  "src\\parser.ts::parsePlainStatement" -> "src\\parser.ts::peek";
  "src\\parser.ts::parsePlainStatement" -> "src\\errors.ts::fail";
  "src\\parser.ts::parsePlainStatement" -> "src\\parser.ts::advance";
  "src\\parser.ts::parsePlainStatement" -> "src\\parser.ts::parseExprAndSemicolon";
  "src\\parser.ts::parseOperand" -> "src\\parser.ts::peek";
  "src\\parser.ts::parseOperand" -> "src\\errors.ts::fail";
  "src\\parser.ts::parseOperand" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseExpr" -> "src\\parser.ts::parseOr";
  "src\\parser.ts::parseOr" -> "src\\parser.ts::parseAnd";
  "src\\parser.ts::parseOr" -> "src\\parser.ts::peek";
  "src\\parser.ts::parseOr" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseAnd" -> "src\\parser.ts::parseComparison";
  "src\\parser.ts::parseAnd" -> "src\\parser.ts::peek";
  "src\\parser.ts::parseAnd" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseComparison" -> "src\\parser.ts::parseOperand";
  "src\\parser.ts::parseComparison" -> "src\\parser.ts::peek";
  "src\\parser.ts::parseComparison" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseConditionBlock" -> "src\\parser.ts::peek";
  "src\\parser.ts::parseConditionBlock" -> "src\\errors.ts::fail";
  "src\\parser.ts::parseConditionBlock" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseConditionBlock" -> "src\\parser.ts::parseExpr";
  "src\\parser.ts::parseConditionBlock" -> "src\\parser.ts::expectOpenBrace";
  "src\\parser.ts::parseConditionBlock" -> "src\\parser.ts::parseStatements";
  "src\\parser.ts::parseIf" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseIf" -> "src\\parser.ts::parseConditionBlock";
  "src\\parser.ts::parseIf" -> "src\\parser.ts::peek";
  "src\\parser.ts::parseIf" -> "src\\parser.ts::expectOpenBrace";
  "src\\parser.ts::parseIf" -> "src\\parser.ts::parseStatements";
  "src\\parser.ts::parseIf" -> "src\\errors.ts::fail";
  "src\\parser.ts::parseWhile" -> "src\\parser.ts::advance";
  "src\\parser.ts::parseWhile" -> "src\\parser.ts::parseConditionBlock";
  "src\\parser.ts::groupStatements" -> "src\\parser.ts::parseStatements";
