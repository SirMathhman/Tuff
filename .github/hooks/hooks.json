{
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "cmd /c \"pnpm run test:jest 1>&2\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"pnpm run format:prettier 1>&2\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"pnpm run lint:typecheck 1>&2\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"pnpm run lint:eslint 1>&2\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"pnpm run lint:pmd:cpd 1>&2\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"pnpm run lint:circular-packages 1>&2\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
