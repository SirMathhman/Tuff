{
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "cmd /c \"bun run test\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"bun run format:prettier\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"bun run lint:eslint\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      },
      {
        "type": "command",
        "command": "cmd /c \"bun run cpd\"; if ($LASTEXITCODE -ne 0) { exit 2 }"
      }
    ]
  }
}
