{
  "name": "tuff",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test test/ --coverage",
    "typecheck": "tsc --noEmit",
    "cpd": "pmd cpd src/ test/ --language typescript --minimum-tokens 50 --ignore-identifiers --ignore-literals",
    "circular": "madge ./src --circular --extensions ts",
    "visualize": "madge ./src --image ./docs/graph.svg --extensions ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "madge": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
