{
  "name": "tuff",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint .",
    "lint:review-only": "echo 'Do not run this command if you are not a reviewer agent.' 1>&2 && npm run typecheck && eslint --config eslint.review.config.ts .",
    "callgraph": "bun tools/callgraph.ts",
    "callgraph:watch": "nodemon",
    "pmd:cpd": "pmd cpd src --language typescript --minimum-tokens 100 --ignore-identifiers --ignore-literals",
    "madge:circular": "madge . --circular --extensions ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "madge": "^8.0.0",
    "nodemon": "^3.1.14",
    "typescript-eslint": "^8.68.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
