{
  "name": "tuffc",
  "version": "1.0.0",
  "description": "The Tuff compiler",
  "homepage": "https://github.com/SirMathhman/Tuff#readme",
  "bugs": {
    "url": "https://github.com/SirMathhman/Tuff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirMathhman/Tuff.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test:jest": "jest",
    "format:prettier": "prettier --write .",
    "lint:typecheck": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:pmd:cpd": "pmd cpd --minimum-tokens 100 --language typescript src",
    "madge:visualize": "madge ./src --image ./docs/graph.svg --extensions ts",
    "madge:circular": "madge ./src --extensions ts --circular"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "madge": {
    "graphVizOptions": {
      "G": {
        "rankdir": "TB",
        "overlap": "false",
        "splines": "ortho"
      }
    }
  }
}
