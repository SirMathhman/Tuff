{
  "name": "tuff",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test test/ --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "cpd": "pmd cpd src/ test/ --language typescript --minimum-tokens 50 --ignore-identifiers --ignore-literals",
    "circular": "madge ./src --circular --extensions ts",
    "visualize": "madge ./src --image ./docs/graph.svg --extensions ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "madge": "^8.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
