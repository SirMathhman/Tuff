{
  "name": "tuff",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/utils": "^8",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "markdownlint": "^0.42.2",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "lint": "eslint . && bun scripts/max-files-per-dir.ts && markdownlint-cli2 \"**/*.md\"",
    "repl": "bun run src/repl.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "cpd": "pmd cpd --language typescript --minimum-tokens 100 --ignore-identifiers --ignore-literals --dir src --dir eslint-rules --dir scripts --dir eslint.config.ts"
  }
}
