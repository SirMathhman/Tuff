struct Ok<T> {
    field : T
}

struct Err<X> {
    field : X
}

type Result<T, X> = Ok<T> | Err<X>;

struct Some<T> {
    field : T
}

struct None {}

type Option<T> = Some<T> | None;

struct CompileError {
  message: &Str,
  reason: &Str,
  suggestedFix: &Str,
  line: &Str,
  column: &Str
}

struct Token {
  type : &Str,
  value : &Str,
  line : U32,
  column : U32,
  typeSuffix : Option<&Str>
}

struct NumberLiteralNode {
    value : I32,
    line : U32,
    column : U32
}

struct IdentifierNode {
    name : &Str,
    line : U32,
    column : U32
}

struct LetDeclarationNode {
    name : &Str,
    mutable : Bool,
    typeName : Option<&Str>,
    value : Expression,
    line : U32,
    column : U32
}

struct AssignmentNode {
    name : &Str,
    value : Expression,
    line : U32,
    column : U32
}

struct StructField {
    name : &Str,
    typeName : &Str
}

struct Vec<T> {

}

struct StructDefinitionNode {
    name : &Str,
    typeParams : Vec<&Str>,
    fields : Vec<StructField>,
    line : U32,
    column : U32
}

struct MemberAssignmentNode {
    object : Expression,
    field : &Str,
    value : Expression,
    line : U32,
    column : U32
}

struct TypeAliasNode {
    name : &Str,
    typeParams : Vec<&Str>,
    underlyingType : &Str,
    line : U32,
    column : U32
}

type Statement = NumberLiteralNode | IdentifierNode | LetDeclarationNode | AssignmentNode | StructDefinitionNode | MemberAssignmentNode | TypeAliasNode | IsExpressionExpr | LogicalExpressionExpr | NotExpressionExpr;

struct NumberLiteralExpr {
    value : I32,
    typeName : Option<&Str>
}

struct BooleanLiteralExpr {
    value : Bool
}

struct IdentifierExpr {
    name : &Str
}

struct StructInstanceExpr {
    structName : &Str,
    typeArgs : Vec<&Str>,
    fields : Vec<StructField>
}

struct MemberExpressionExpr {
    object : Expression,
    field : &Str
}

struct IsExpressionExpr {
    operand : Expression,
    typeName : &Str
}

enum LogicalOperator {
    AND,
    OR
}

struct LogicalExpressionExpr {
    operator : LogicalOperator,
    left : Expression,
    right : Expression,
    line : U32,
    column : U32
}

struct NotExpressionExpr {
    operand : Expression,
    line : U32,
    column : U32
}

struct StringLiteralExpr {
    value : &Str,
    line : U32,
    column : U32
}

type Expression = NumberLiteralExpr | BooleanLiteralExpr | StringLiteralExpr | IdentifierExpr | StructInstanceExpr | MemberExpressionExpr | IsExpressionExpr | LogicalExpressionExpr | NotExpressionExpr;

struct VarEntry {
    name : &Str,
    mutable : Bool,
    typeName : Option<&Str>
}

struct StructDef {
    name : &Str,
    typeParams : Vec<&Str>,
    fields : Vec<StructField>,
    resolvedFields : Option<Vec<StructField>>
}

struct TypeAliasDef {
    name : &Str,
    typeParams : Vec<&Str>,
    underlyingType : &Str
}

struct TypeCheckCtx {
    scope : Vec<VarEntry>,
    structs : Vec<StructDef>,
    aliases : Vec<TypeAliasDef>,
    loc : (U32, U32)
}

enum ValidTypes {
    U8,
    U16,
    U32,
    U64,
    I8,
    I16,
    I32,
    I64,
    Bool,
    Str,
    USize
}

let x = 42;
x