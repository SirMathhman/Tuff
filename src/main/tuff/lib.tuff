struct Ok<T> {
    field : T
}

struct Err<X> {
    field : X
}

type Result<T, X> = Ok<T> | Err<X>;

struct Some<T> {
    field : T
}

struct None {}

type Option<T> = Some<T> | None;

struct CompileError {
  message: &Str,
  reason: &Str,
  suggestedFix: &Str,
  line: &Str,
  column: &Str
}

struct Token {
  type : &Str,
  value : &Str,
  line : U32,
  column : U32,
  typeSuffix : Option<&Str>
}

